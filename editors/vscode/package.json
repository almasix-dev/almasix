{
  "name": "almasix",
  "displayName": "Almasix",
  "description": "Prism templates, Almasix LSP, and Smith helpers for VS Code / Cursor / VSCodium",
  "version": "0.1.0",
  "publisher": "almasix",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "almasix",
    "prism",
    "laravel",
    "python",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:prism-html",
    "workspaceContains:bootstrap/app.py"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "prism-html",
        "aliases": [
          "Prism",
          "prism-html",
          "Prism HTML"
        ],
        "extensions": [
          ".prism.html"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "prism-html",
        "scopeName": "text.html.prism",
        "path": "./syntaxes/prism.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python",
          "text.html.basic": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "prism-html",
        "path": "./snippets/prism.code-snippets"
      }
    ],
    "configuration": {
      "title": "Almasix",
      "properties": {
        "almasix.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter that has almasix[lsp] installed (e.g. ${workspaceFolder}/.venv/bin/python). Empty = try PATH, then .venv."
        },
        "almasix.lsp.command": {
          "type": "string",
          "default": "",
          "description": "Override LSP launch command. Empty = almasix-lsp or python -m almasix.lsp."
        },
        "almasix.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for the language server process."
        }
      }
    },
    "commands": [
      {
        "command": "almasix.rebuildIndex",
        "title": "Almasix: Rebuild LSP Index"
      },
      {
        "command": "almasix.showAppInfo",
        "title": "Almasix: Show Application Info"
      },
      {
        "command": "almasix.restartServer",
        "title": "Almasix: Restart Language Server"
      }
    ],
    "taskDefinitions": [
      {
        "type": "almasix",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Smith task name (serve, queue:work, migrate, test)"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "sync-prism": "node ./scripts/sync-prism.js",
    "prepackage": "npm run sync-prism && npm run compile",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "vsce": "npm run package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almasix-dev/almasix.git"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
