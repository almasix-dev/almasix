"""Welcome controller — marketing landing for web routes."""

from __future__ import annotations

from almasix.auth import auth
from almasix.config import config
from almasix.http import Controller, Request, Response
from almasix.prism import view
from almasix.routing import url


class WelcomeController(Controller):
    """Landing page — branded to the application name."""

    async def index(self, request: Request) -> Response:
        app_name = str(config("app.name", "Almasix"))
        return view(
            "welcome",
            {
                "name": app_name,
                "env": str(config("app.env", "local")),
                "health_url": url("/api/health", absolute=False),
                "login_url": url("/login", absolute=False),
                "register_url": url("/register", absolute=False),
                "dashboard_url": url("/dashboard", absolute=False),
                "status": request.session.get("status"),
                "authenticated": auth().check(),
                "__authenticated": auth().check(),
            },
        )
