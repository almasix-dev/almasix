"""User — the model every guard, notification, and policy starts from."""

from __future__ import annotations

from almasix.auth import AuthenticatableMixin
from almasix.notifications import Notifiable
from almasix.orm import HasFactory, Model


class User(HasFactory, AuthenticatableMixin, Notifiable, Model):
    """A registered user of this application."""

    fillable = ("name", "email", "password")
    hidden = ("password", "remember_token")
    casts = {"email_verified_at": "datetime", "password": "hashed"}  # noqa: RUF012
