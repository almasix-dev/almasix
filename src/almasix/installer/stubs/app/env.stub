APP_NAME={{ app_display }}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:3000
# Public path prefix when hosted under a subpath, e.g. /apps/{{ app_name }}
APP_BASE_PATH=
APP_KEY={{ app_key }}
# Comma-separated previous keys for graceful rotation (optional)
# APP_PREVIOUS_KEYS=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
{{ db_env }}
CACHE_STORE=file
CACHE_PREFIX=almasix_cache_
REDIS_CLIENT=default
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379/0
SESSION_DRIVER=cookie
