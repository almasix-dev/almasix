:root {
  color-scheme: light dark;
  --ink: #1a1d23;
  --paper: #f6f7f9;
  --muted: #5b6575;
}

body {
  margin: 0;
  min-height: 100vh;
  font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--ink);
  background: var(--paper);
}

main {
  max-width: 48rem;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

a {
  color: #2563eb;
}
