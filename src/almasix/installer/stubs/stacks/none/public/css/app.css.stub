:root {
  color-scheme: light dark;
  --brand: #f1511b;
  --brand-soft: #ff7a4d;
  --ink: #0f172a;
  --muted: #64748b;
  --paper: #f8fafc;
  --card: #ffffff;
  --line: #e2e8f0;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--ink);
  background: var(--paper);
  display: flex;
  flex-direction: column;
}
a { color: var(--brand); text-decoration: none; }
a:hover { color: var(--brand-soft); }
.site-header, .site-footer {
  border-color: var(--line);
  background: var(--card);
}
.site-header {
  border-bottom: 1px solid var(--line);
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.site-header .brand { font-weight: 600; font-size: 1.1rem; color: var(--ink); }
.site-nav { display: flex; gap: 0.75rem; align-items: center; font-size: 0.9rem; font-weight: 500; }
.site-nav a.muted { color: var(--muted); }
.btn {
  display: inline-block;
  border-radius: 0.5rem;
  padding: 0.55rem 1.1rem;
  font-weight: 600;
  font-size: 0.9rem;
  border: 1px solid transparent;
  cursor: pointer;
  background: var(--brand);
  color: #fff;
}
.btn:hover { background: var(--brand-soft); color: #fff; }
.btn-ghost {
  background: #fff;
  color: var(--ink);
  border-color: var(--line);
}
.btn-ghost:hover { border-color: var(--brand); color: var(--brand); }
.btn-link {
  background: transparent;
  color: var(--muted);
  border: 0;
  padding: 0;
  font: inherit;
  cursor: pointer;
}
main.wrap { flex: 1; width: 100%; max-width: 56rem; margin: 0 auto; padding: 2.5rem 1.5rem; }
.hero h1 { font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.03em; margin: 0.5rem 0 0; }
.hero .eyebrow { color: var(--brand); font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.06em; }
.hero .lede { color: var(--muted); font-size: 1.1rem; max-width: 36rem; }
.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
.grid { display: grid; gap: 1rem; margin-top: 2.5rem; }
@media (min-width: 40rem) { .grid { grid-template-columns: repeat(3, 1fr); } }
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 1rem;
  padding: 1.25rem;
  box-shadow: 0 1px 2px rgb(15 23 42 / 4%);
}
.card h2 { margin: 0; font-size: 1.05rem; }
.card p { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.9rem; }
.flash { border-radius: 0.5rem; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.9rem; }
.flash-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
.flash-status { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
.auth-panel { max-width: 28rem; margin: 0 auto; }
label { display: block; font-size: 0.9rem; font-weight: 500; margin-bottom: 0.85rem; }
input[type=text], input[type=email], input[type=password] {
  display: block;
  width: 100%;
  margin-top: 0.35rem;
  padding: 0.55rem 0.75rem;
  border: 1px solid var(--line);
  border-radius: 0.5rem;
  font: inherit;
}
.remember { display: flex; align-items: center; gap: 0.5rem; font-weight: 400; color: var(--muted); }
.site-footer { border-top: 1px solid var(--line); padding: 1.25rem; text-align: center; color: var(--muted); font-size: 0.85rem; }
.error-page { text-align: center; padding: 4rem 1.5rem; }
.error-page .code { font-size: 3.5rem; font-weight: 600; color: var(--brand); letter-spacing: -0.04em; margin: 0; }
