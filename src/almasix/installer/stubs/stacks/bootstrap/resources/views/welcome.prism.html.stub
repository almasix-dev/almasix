<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ name }}</title>
  {{-- Points at the Vite dev server while `npm run dev` runs, and at the
       built files in public/build once `npm run build` has. --}}
  @vite(['resources/css/app.scss', 'resources/js/app.js'])
</head>
<body class="bg-body-tertiary">
  <main class="container py-5" style="max-width: 42rem">
    <h1 class="display-5 fw-semibold">Welcome to Almasix</h1>
    <p class="text-secondary">{{ name }} is running in {{ env }}.</p>
    <p class="text-secondary">
      Web routes render HTML; API routes return JSON — try
      <a href="{{ health_url }}">{{ health_url }}</a>.
    </p>
  </main>
</body>
</html>
