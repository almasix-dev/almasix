"""Forgot / reset password (Inertia)."""

from __future__ import annotations

from almasix.auth.passwords import Password
from almasix.config import config
from almasix.hashing import Hash
from almasix.http import Controller, Request, redirect
from inertia import Inertia


class PasswordResetController(Controller):
    async def create(self, request: Request):
        return Inertia.render(
            "Auth/ForgotPassword",
            {
                "appName": str(config("app.name", "{{ app_display }}")),
                "status": request.session.get("status"),
            },
        )

    async def store(self, request: Request):
        email = str(request.input("email") or "").strip()
        if not email:
            request.session.flash("errors", {"email": ["Email is required."]})
            return redirect("/forgot-password")
        status = await Password.send_reset_link({"email": email})
        request.session.flash("status", Password.status_message(status))
        return redirect("/forgot-password")

    async def edit(self, request: Request, token: str):
        return Inertia.render(
            "Auth/ResetPassword",
            {
                "appName": str(config("app.name", "{{ app_display }}")),
                "token": token,
                "email": str(request.query("email") or request.input("email") or ""),
            },
        )

    async def update(self, request: Request):
        credentials = {
            "email": str(request.input("email") or "").strip(),
            "password": str(request.input("password") or ""),
            "password_confirmation": str(request.input("password_confirmation") or ""),
            "token": str(request.input("token") or ""),
        }

        async def _set_password(user, password: str) -> None:
            user.set_attribute("password", Hash.make(password))
            await user.save()

        status = await Password.reset(credentials, _set_password)
        if status != Password.PASSWORD_RESET:
            request.session.flash("errors", {"email": [Password.status_message(status)]})
            return redirect(f"/reset-password/{credentials['token']}")
        request.session.flash("status", Password.status_message(status))
        return redirect("/login")
