"""TOTP helpers (RFC 6238) — stdlib only, no pyotp."""

from __future__ import annotations

import base64
import hashlib
import hmac
import json
import secrets
import struct
import time
from typing import Iterable


def generate_secret(nbytes: int = 20) -> str:
    """Return a base32-encoded shared secret (no padding)."""
    return base64.b32encode(secrets.token_bytes(nbytes)).decode("ascii").rstrip("=")


def provisioning_uri(secret: str, *, account: str, issuer: str = "{{ app_display }}") -> str:
    """otpauth:// URI for authenticator apps."""
    from urllib.parse import quote

    label = quote(f"{issuer}:{account}")
    iss = quote(issuer)
    return f"otpauth://totp/{label}?secret={secret}&issuer={iss}&algorithm=SHA1&digits=6&period=30"


def _normalize_secret(secret: str) -> bytes:
    raw = secret.strip().upper().replace(" ", "")
    pad = "=" * ((8 - len(raw) % 8) % 8)
    return base64.b32decode(raw + pad, casefold=True)


def totp(
    secret: str,
    *,
    for_time: float | None = None,
    step: int = 30,
    digits: int = 6,
) -> str:
    """Compute the TOTP code for ``secret`` at ``for_time`` (default: now)."""
    counter = int((for_time if for_time is not None else time.time()) // step)
    key = _normalize_secret(secret)
    msg = struct.pack(">Q", counter)
    digest = hmac.new(key, msg, hashlib.sha1).digest()
    offset = digest[-1] & 0x0F
    code = struct.unpack(">I", digest[offset : offset + 4])[0] & 0x7FFFFFFF
    return str(code % (10**digits)).zfill(digits)


def verify(
    secret: str,
    code: str,
    *,
    window: int = 1,
    step: int = 30,
    digits: int = 6,
) -> bool:
    """Accept ``code`` if it matches within ``window`` steps of now."""
    cleaned = "".join(c for c in str(code) if c.isdigit())
    if len(cleaned) != digits:
        return False
    now = time.time()
    for drift in range(-window, window + 1):
        expected = totp(secret, for_time=now + drift * step, step=step, digits=digits)
        if hmac.compare_digest(expected, cleaned):
            return True
    return False


def generate_recovery_codes(count: int = 8) -> list[str]:
    """Plain recovery codes (``xxxx-xxxx``) — hash before storing."""
    codes: list[str] = []
    for _ in range(count):
        left = secrets.token_hex(2)
        right = secrets.token_hex(2)
        codes.append(f"{left}-{right}")
    return codes


def _app_key_bytes() -> bytes:
    try:
        from almasix.config import config

        key = str(config("app.key") or "almasix-dev-key")
    except Exception:
        key = "almasix-dev-key"
    if key.startswith("base64:"):
        key = key[7:]
    return key.encode("utf-8")


def hash_recovery_code(code: str) -> str:
    """HMAC-SHA256 of a recovery code with the application key."""
    normalized = str(code).strip().lower().replace(" ", "")
    return hmac.new(_app_key_bytes(), normalized.encode("utf-8"), hashlib.sha256).hexdigest()


def hash_recovery_codes(codes: Iterable[str]) -> list[str]:
    return [hash_recovery_code(c) for c in codes]


def dump_recovery_hashes(hashes: list[str]) -> str:
    return json.dumps(list(hashes))


def load_recovery_hashes(raw: str | None) -> list[str]:
    if not raw:
        return []
    try:
        data = json.loads(raw)
    except (TypeError, ValueError, json.JSONDecodeError):
        return []
    return [str(x) for x in data] if isinstance(data, list) else []


def consume_recovery_code(stored_json: str | None, code: str) -> tuple[bool, str]:
    """Return (ok, updated_json) after consuming a matching recovery code."""
    hashes = load_recovery_hashes(stored_json)
    target = hash_recovery_code(code)
    for i, existing in enumerate(hashes):
        if hmac.compare_digest(existing, target):
            del hashes[i]
            return True, dump_recovery_hashes(hashes)
    return False, stored_json or "[]"
