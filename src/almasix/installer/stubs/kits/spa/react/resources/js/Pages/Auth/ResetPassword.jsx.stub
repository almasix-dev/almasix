import { Head, useForm } from "@inertiajs/react";
import GuestLayout from "../Layouts/GuestLayout";
import TextInput from "../Components/TextInput";
import PrimaryButton from "../Components/PrimaryButton";

export default function ResetPassword({ token, email, appName }) {
  const { data, setData, post, processing, errors } = useForm({
    token,
    email: email || "",
    password: "",
    password_confirmation: "",
  });
  return (
    <GuestLayout title="Choose a new password" appName={appName}>
      <Head title="Reset password" />
      <form onSubmit={(e) => { e.preventDefault(); post("/reset-password"); }} className="space-y-4">
        <TextInput label="Email" type="email" value={data.email} onChange={(e) => setData("email", e.target.value)} error={errors.email} />
        <TextInput label="Password" type="password" value={data.password} onChange={(e) => setData("password", e.target.value)} error={errors.password} autoFocus />
        <TextInput label="Confirm password" type="password" value={data.password_confirmation} onChange={(e) => setData("password_confirmation", e.target.value)} />
        <PrimaryButton disabled={processing}>Reset password</PrimaryButton>
      </form>
    </GuestLayout>
  );
}
