import { Head } from "@inertiajs/react";
import AuthenticatedLayout from "../Layouts/AuthenticatedLayout";

export default function Dashboard({ userName }) {
  return (
    <AuthenticatedLayout title="Dashboard">
      <Head title="Dashboard" />
      <div className="mx-auto max-w-3xl">
        <p className="font-display text-3xl font-semibold tracking-tight">Welcome back, {userName}.</p>
        <p className="mt-2 text-muted">
          Your workspace is quiet on purpose — jump into settings, teams, or notifications when you need them.
        </p>
        <div className="mt-8 grid gap-4 sm:grid-cols-3">
          {[
            ["Settings", "Profile, password, 2FA, appearance", "/settings/profile"],
            ["Teams", "Create and switch workspaces", "/teams"],
