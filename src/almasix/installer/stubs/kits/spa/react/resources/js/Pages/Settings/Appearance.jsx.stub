import { Head } from "@inertiajs/react";
import AuthenticatedLayout from "../../Layouts/AuthenticatedLayout";
import ThemeToggle from "../../Components/ThemeToggle";

export default function Appearance({ status }) {
  return (
    <AuthenticatedLayout title="Appearance">
      <Head title="Appearance" />
      <div className="mx-auto max-w-xl rounded-2xl border border-line bg-panel p-6">
        <h2 className="font-display text-xl font-semibold">Theme</h2>
        <p className="mt-1 text-sm text-muted">Forge supports light and dark. Your choice is stored in this browser.</p>
        {status ? <p className="mt-3 text-sm text-brand">{status}</p> : null}
        <div className="mt-6 flex items-center gap-4">
          <ThemeToggle />
          <span className="text-sm text-muted">Toggle light / dark</span>
        </div>
      </div>
    </AuthenticatedLayout>
  );
}
