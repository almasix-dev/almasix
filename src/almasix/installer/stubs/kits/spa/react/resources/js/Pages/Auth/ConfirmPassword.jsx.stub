import { Head, useForm } from "@inertiajs/react";
import GuestLayout from "../Layouts/GuestLayout";
import TextInput from "../Components/TextInput";
import PrimaryButton from "../Components/PrimaryButton";

export default function ConfirmPassword() {
  const { data, setData, post, processing, errors } = useForm({ password: "" });
  return (
    <GuestLayout title="Confirm password">
      <Head title="Confirm password" />
      <p className="mb-4 text-sm text-muted">This is a secure area. Please confirm your password to continue.</p>
      <form onSubmit={(e) => { e.preventDefault(); post("/confirm-password"); }} className="space-y-4">
        <TextInput label="Password" type="password" value={data.password} onChange={(e) => setData("password", e.target.value)} error={errors.password} autoFocus />
        <PrimaryButton disabled={processing}>Confirm</PrimaryButton>
      </form>
    </GuestLayout>
  );
}
