<script>
  import { Head, useForm } from "@inertiajs/svelte";
  import AuthenticatedLayout from "../../Layouts/AuthenticatedLayout.svelte";
  let { team = {}, members = [], invitations = [], isOwner = false, status = "" } = $props();
  const rename = useForm({ name: team?.name || "" });
  const invite = useForm({ email: "", role: "member" });
</script>
<AuthenticatedLayout title={team?.name || "Team"}>
  <Head title={team?.name || "Team"} />
  <div class="mx-auto max-w-2xl space-y-8">
    {#if status}<p class="text-sm text-brand">{status}</p>{/if}
    {#if isOwner}
      <section class="rounded-2xl border border-line bg-panel p-6">
        <h2 class="font-display text-xl font-semibold">Team settings</h2>
        <form class="mt-4 space-y-4" onsubmit={(e) => { e.preventDefault(); $rename.put(`/teams/${team.id}`); }}>
          <label class="block space-y-1.5"><span class="text-sm font-medium">Name</span><input bind:value={$rename.name} class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm" /></label>
          <button type="submit" class="rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white">Save</button>
        </form>
      </section>
    {/if}
    <section class="rounded-2xl border border-line bg-panel p-6">
      <h2 class="font-display text-xl font-semibold">Members</h2>
      <ul class="mt-4 space-y-2">
        {#each members as m}
          <li class="flex justify-between text-sm"><span>{m.name} <span class="text-muted">({m.email})</span></span><span class="text-muted">{m.role}</span></li>
        {/each}
      </ul>
    </section>
    {#if isOwner}
      <section class="rounded-2xl border border-line bg-panel p-6">
        <h2 class="font-display text-xl font-semibold">Invite</h2>
        <form class="mt-4 space-y-4" onsubmit={(e) => { e.preventDefault(); $invite.post(`/teams/${team.id}/members`); }}>
          <label class="block space-y-1.5"><span class="text-sm font-medium">Email</span><input bind:value={$invite.email} type="email" class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm" /></label>
          <button type="submit" class="rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white">Send invite</button>
        </form>
      </section>
    {/if}
  </div>
</AuthenticatedLayout>
