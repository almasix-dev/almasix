<script>
  import { Head, useForm } from "@inertiajs/svelte";
  import GuestLayout from "../../Layouts/GuestLayout.svelte";
  let { token = "", email = "", appName = "{{ app_display }}" } = $props();
  const form = useForm({ token, email, password: "", password_confirmation: "" });
</script>
<GuestLayout title="Choose a new password" {appName}>
  <Head title="Reset password" />
  <form class="space-y-4" onsubmit={(e) => { e.preventDefault(); $form.post("/reset-password"); }}>
    <label class="block space-y-1.5"><span class="text-sm font-medium">Email</span><input bind:value={$form.email} type="email" class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm" /></label>
    <label class="block space-y-1.5"><span class="text-sm font-medium">Password</span><input bind:value={$form.password} type="password" class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm" /></label>
    <label class="block space-y-1.5"><span class="text-sm font-medium">Confirm password</span><input bind:value={$form.password_confirmation} type="password" class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm" /></label>
    <button type="submit" class="w-full rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white">Reset password</button>
  </form>
</GuestLayout>
