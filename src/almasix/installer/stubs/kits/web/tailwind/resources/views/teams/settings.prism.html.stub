  <form method="post" action="{{ invite_url }}" class="mt-10 max-w-md space-y-3">
    @csrf
    <h2 class="font-semibold">Invite member</h2>
    <input type="email" name="email" required placeholder="email@example.com" class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm"/>
