"""Profile — update profile, password, photo, delete account."""

from __future__ import annotations

import uuid
from pathlib import Path

from almasix.auth import auth
from almasix.config import config
from almasix.hashing import Hash
from almasix.http import Controller, Request, Response, redirect
from almasix.prism import view
from almasix.routing import url
from almasix.translation import __


class ProfileController(Controller):
    async def edit(self, request: Request) -> Response:
        user = auth().user()
        name = _attr(user, "name")
        return view(
            "settings.profile",
            {
                "name": str(config("app.name", "{{ app_display }}")),
                "user": user,
                "user_name": name,
                "user_email": _attr(user, "email"),
                "user_initials": _initials(name),
                "photo_url": (
                    user.profile_photo_url()
                    if user is not None and hasattr(user, "profile_photo_url")
                    else None
                ),
                "status": request.session.get("status"),
                "error": request.session.get("error"),
                "update_url": url("/user/profile-information", absolute=False),
                "photo_action": url("/user/profile-photo", absolute=False),
                "delete_url": url("/user", absolute=False),
                "__authenticated": True,
            },
        )

    async def update(self, request: Request) -> Response:
        user = auth().user()
        if user is None:
            return redirect("/login")
        name = str(request.input("name") or "").strip()
        email = str(request.input("email") or "").strip()
        if not name or not email:
            request.session.flash("error", "Name and email are required.")
            return redirect("/user/profile")
        user.set_attribute("name", name)
        if email != _attr(user, "email"):
            user.set_attribute("email", email)
            user.set_attribute("email_verified_at", None)
        await user.save()
        request.session.flash("status", "Profile updated.")
        return redirect("/user/profile")

    async def update_password(self, request: Request) -> Response:
        user = auth().user()
        if user is None:
            return redirect("/login")
        current = str(request.input("current_password") or "")
        password = str(request.input("password") or "")
        confirm = str(request.input("password_confirmation") or "")
        hashed = (
            user.get_auth_password()
            if hasattr(user, "get_auth_password")
            else getattr(user, "password", None)
        )
        if not hashed or not Hash.check(current, str(hashed)):
            request.session.flash("error", __("auth.password"))
            return redirect("/user/password")
        if not password or password != confirm:
            request.session.flash("error", "Password confirmation does not match.")
            return redirect("/user/password")
        user.set_attribute("password", password)
        await user.save()
        request.session.flash("status", "Password updated.")
        return redirect("/user/password")

    async def edit_password(self, request: Request) -> Response:
        return view(
            "settings.password",
            {
                "name": str(config("app.name", "{{ app_display }}")),
                "form_action": url("/user/password", absolute=False),
                "status": request.session.get("status"),
                "error": request.session.get("error"),
                "__authenticated": True,
            },
        )

    async def appearance(self, request: Request) -> Response:
        return view(
            "settings.appearance",
            {
                "name": str(config("app.name", "{{ app_display }}")),
                "__authenticated": True,
            },
        )

    async def update_photo(self, request: Request) -> Response:
        user = auth().user()
        if user is None:
            return redirect("/login")
        upload = request.file("photo")
        if upload is None:
            request.session.flash("error", "Choose an image file, then click Save photo.")
            return redirect("/user/profile")
        if isinstance(upload, list):
            upload = upload[0]
        if not getattr(upload, "filename", None):
            request.session.flash("error", "Choose an image file, then click Save photo.")
            return redirect("/user/profile")
        suffix = Path(str(upload.filename)).suffix.lower()
        if suffix not in {".jpg", ".jpeg", ".png", ".gif", ".webp"}:
            request.session.flash("error", "Use a JPG, PNG, GIF, or WebP image.")
            return redirect("/user/profile")
        stored = await upload.store_as(
            "profile-photos",
            f"{uuid.uuid4().hex}{suffix}",
            disk="public",
        )
        previous = _attr(user, "profile_photo_path")
        user.set_attribute("profile_photo_path", stored)
        await user.save()
        if previous and previous != stored:
            try:
                from almasix.filesystem import Storage

                Storage.disk("public").delete(str(previous))
            except Exception:
                pass
        request.session.flash("status", "Profile photo updated.")
        return redirect("/user/profile")

    async def destroy(self, request: Request) -> Response:
        user = auth().user()
        if user is None:
            return redirect("/login")
        password = str(request.input("password") or "")
        hashed = (
            user.get_auth_password()
            if hasattr(user, "get_auth_password")
            else getattr(user, "password", None)
        )
        if not hashed or not Hash.check(password, str(hashed)):
            request.session.flash("error", __("auth.password"))
            return redirect("/user/profile")
        await auth().logout()
        await user.delete()
        request.session.flash("status", "Your account has been deleted.")
        return redirect("/")


def _attr(user, key: str):
    if user is None:
        return ""
    if hasattr(user, "get_attribute"):
        return user.get_attribute(key) or ""
    return getattr(user, key, "") or ""


def _initials(name: str) -> str:
    parts = [p for p in str(name or "").split() if p]
    if not parts:
        return "?"
    if len(parts) == 1:
        return parts[0][:2].upper()
    return (parts[0][0] + parts[-1][0]).upper()
