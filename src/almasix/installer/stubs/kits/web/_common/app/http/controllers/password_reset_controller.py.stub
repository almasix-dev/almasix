"""Password reset — forgot + reset via Password broker."""

from __future__ import annotations

from almasix.auth.passwords import Password
from almasix.config import config
from almasix.http import Controller, Request, Response, redirect
from almasix.prism import view
from almasix.routing import url


class PasswordResetController(Controller):
    async def show_forgot(self, request: Request) -> Response:
        return view(
            "auth.forgot-password",
            {
                "name": str(config("app.name", "{{ app_display }}")),
                "form_action": url("/forgot-password", absolute=False),
                "login_url": url("/login", absolute=False),
                "status": request.session.get("status"),
                "error": request.session.get("error"),
                "__authenticated": False,
            },
        )

    async def send_link(self, request: Request) -> Response:
        email = str(request.input("email") or "").strip()
        if not email:
            request.session.flash("error", "Email is required.")
            return redirect("/forgot-password")
        status = await Password.send_reset_link({"email": email})
        if status != Password.RESET_LINK_SENT:
            request.session.flash("error", Password.status_message(status))
            return redirect("/forgot-password")
        request.session.flash("status", Password.status_message(status))
        return redirect("/forgot-password")

    async def show_reset(self, request: Request, token: str) -> Response:
        return view(
            "auth.reset-password",
            {
                "name": str(config("app.name", "{{ app_display }}")),
                "form_action": url(f"/reset-password/{token}", absolute=False),
                "token": token,
                "email": str(request.input("email") or request.query("email") or ""),
                "error": request.session.get("error"),
                "__authenticated": False,
            },
        )

    async def reset(self, request: Request, token: str) -> Response:
        email = str(request.input("email") or "").strip()
        password = str(request.input("password") or "")
        confirm = str(request.input("password_confirmation") or "")
        if not email or not password:
            request.session.flash("error", "Email and password are required.")
            return redirect(f"/reset-password/{token}")
        if password != confirm:
            request.session.flash("error", "Password confirmation does not match.")
            return redirect(f"/reset-password/{token}")

        async def _set_password(user, new_password: str) -> None:
            user.set_attribute("password", new_password)
            await user.save()

        status = await Password.reset(
            {"email": email, "password": password, "token": token},
            _set_password,
        )
        if status != Password.PASSWORD_RESET:
            request.session.flash("error", Password.status_message(status))
            return redirect(f"/reset-password/{token}")
        request.session.flash("status", Password.status_message(status))
        return redirect("/login")
