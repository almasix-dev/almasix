<div class="theme-toggle inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white p-0.5 text-xs dark:border-slate-700 dark:bg-slate-900" role="group" aria-label="Theme">
  <button type="button" wire:click="set_mode('light')" onclick="window.__forgeSetTheme && window.__forgeSetTheme('light')"
          class="rounded-md px-2.5 py-1.5 font-medium transition @if(mode == 'light') bg-brand text-white @else text-slate-600 dark:text-slate-300 @endif">Light</button>
  <button type="button" wire:click="set_mode('dark')" onclick="window.__forgeSetTheme && window.__forgeSetTheme('dark')"
          class="rounded-md px-2.5 py-1.5 font-medium transition @if(mode == 'dark') bg-brand text-white @else text-slate-600 dark:text-slate-300 @endif">Dark</button>
  <button type="button" wire:click="set_mode('system')" onclick="window.__forgeSetTheme && window.__forgeSetTheme('system')"
          class="rounded-md px-2.5 py-1.5 font-medium transition @if(mode == 'system') bg-brand text-white @else text-slate-600 dark:text-slate-300 @endif">System</button>
</div>
