    <p class="small text-secondary">This cannot be undone.</p>
    <form method="post" action="{{ delete_url }}">
      @csrf
      {!! method_field('DELETE') !!}
      <label class="form-label small">Confirm password</label>
      <input type="password" name="password" required autocomplete="current-password" placeholder="Your password" class="form-control form-control-sm mb-2"/>
      <button type="submit" class="btn btn-danger btn-sm">Delete account</button>
    </form>
  </div>
