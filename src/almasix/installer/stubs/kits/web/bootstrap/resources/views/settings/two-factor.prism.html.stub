  @if(enabled)
    <p class="text-success fw-medium mt-3">Two-factor is enabled.</p>
    <form method="post" action="{{ disable_url }}" class="d-inline">@csrf{!! method_field('DELETE') !!}<button class="btn btn-outline-danger btn-sm" type="submit">Disable</button></form>
    <form method="post" action="{{ recovery_url }}" class="d-inline ms-2">@csrf<button class="btn btn-link btn-sm" type="submit">Regenerate recovery codes</button></form>
  @elseif(pending)
    <p class="small text-secondary mt-3">Scan this URI, then confirm with a code.</p>
    <code class="d-block small p-2 bg-light border rounded mb-3">{{ qr_uri }}</code>
    <form method="post" action="{{ confirm_url }}" class="col-md-4">@csrf
      <input type="text" name="code" required class="form-control mb-2" placeholder="6-digit code"/>
      <button class="btn btn-brand" type="submit">Confirm</button>
    </form>
  @else
    <form method="post" action="{{ enable_url }}" class="mt-3">@csrf<button class="btn btn-brand" type="submit">Enable two-factor</button></form>
