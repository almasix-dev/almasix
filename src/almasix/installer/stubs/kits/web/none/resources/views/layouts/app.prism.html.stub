  <link rel="stylesheet" href="{{ asset('css/kit.css') }}"/>
  <script>(function(){try{var m=localStorage.getItem('forge-theme')||'system';var d=m==='dark'||(m==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.classList.toggle('dark',d);}catch(e){}})();</script>
  <script>
    window.__forgeSetTheme=function(mode){var m=mode||localStorage.getItem('forge-theme')||'system';var dark=m==='dark'||(m==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.classList.toggle('dark',dark);localStorage.setItem('forge-theme',m);};
  </script>
  @conduitScripts
</head>
