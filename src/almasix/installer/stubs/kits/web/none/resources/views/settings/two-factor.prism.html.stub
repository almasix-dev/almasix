  @elseif(pending)
    <p class="muted" style="font-size:.875rem">Scan this URI, then confirm with a code.</p>
    <code style="display:block;word-break:break-all;padding:.75rem;border:1px solid var(--line);border-radius:.5rem;font-size:.75rem;background:var(--surface)">{{ qr_uri }}</code>
    <form method="post" action="{{ confirm_url }}" style="max-width:16rem;margin-top:1rem">@csrf
      <input type="text" name="code" required placeholder="6-digit code"/>
      <button class="btn" type="submit" style="margin-top:.5rem">Confirm</button>
    </form>
  @else
    <form method="post" action="{{ enable_url }}" style="margin-top:1rem">@csrf<button class="btn" type="submit">Enable two-factor</button></form>
