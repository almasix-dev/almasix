    <form method="post" action="{{ update_url }}" style="margin-top:1rem">@csrf
      {!! method_field('PUT') !!}
      <label class="field">Name<input type="text" name="name" value="{{ user_name }}" required autocomplete="name"/></label>
      <label class="field">Email<input type="email" name="email" value="{{ user_email }}" required autocomplete="email"/></label>
      <button type="submit" class="btn">Save profile</button>
    </form>
  </section>

  <section style="margin-top:2.5rem;max-width:28rem;border:1px solid #fecaca;border-radius:.75rem;padding:1rem">
    <h2 style="margin:0;color:#b91c1c;font-size:1rem">Delete account</h2>
    <p class="muted" style="font-size:.875rem;margin:.35rem 0 0">This cannot be undone.</p>
    <form method="post" action="{{ delete_url }}" style="margin-top:.75rem">@csrf
      {!! method_field('DELETE') !!}
      <label class="field">Confirm password
        <input type="password" name="password" required autocomplete="current-password" placeholder="Your password"/>
      </label>
      <button type="submit" class="btn btn-danger" style="margin-top:.5rem">Delete account</button>
    </form>
  </section>
