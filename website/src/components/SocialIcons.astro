---
/**
 * Header social icons — GitHub with live star count.
 */
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import { githubStarsLabel } from '../lib/github-stars';

const links = config.social || [];
const github = links.find((link) => link.icon === 'github');
const others = links.filter((link) => link.icon !== 'github');

const starsLabel = github ? await githubStarsLabel(github.href) : null;
---

{
	(github || others.length > 0) && (
		<>
			{github && (
				<a href={github.href} rel="me" class="sl-flex github-link" title={github.label}>
					<span class="sr-only">{github.label}</span>
					<Icon name="github" />
					{
						starsLabel && (
							<span class="github-stars" aria-label={`${starsLabel} stars on GitHub`}>
								{starsLabel}
							</span>
						)
					}
				</a>
			)}
			{others.map(({ label, href, icon }) => (
				<a {href} rel="me" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
			align-items: center;
			gap: 0.35rem;
			text-decoration: none;
		}
		a:hover {
			color: var(--sl-color-white);
		}
		.github-stars {
			font-size: var(--sl-text-sm);
			font-weight: 600;
			font-variant-numeric: tabular-nums;
			letter-spacing: 0.01em;
			line-height: 1;
		}
	}
</style>
