APP_NAME=Progress
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:3000
# Public path prefix when hosted under a subpath, e.g. /apps/progress
APP_BASE_PATH=
APP_KEY=base64:progress-local-dev-key-change-me
# APP_PREVIOUS_KEYS=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=array
CACHE_PREFIX=avalon_cache_
REDIS_CLIENT=default
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379/0
SESSION_DRIVER=cookie
