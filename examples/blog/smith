#!/usr/bin/env python
"""Smith — Almasix in-application CLI.

From the application root, the reliable form is always:

    python smith version
    python smith serve
    python smith list
    python smith loupe   # aliases: tinker, repl

After ``pip install -e .`` of *this* application, a ``smith`` console script is
also linked into the active virtualenv, so bare ``smith …`` works there too.
Installing only the framework does not put ``smith`` on PATH.
"""

from __future__ import annotations

from almasix.smith.cli import app

if __name__ == "__main__":
    app()
